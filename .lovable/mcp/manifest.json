        "title": "List my exams",
        "description": "Return exams the signed-in user can currently see in Mudrik Plus. Row-Level Security enforces visibility per student/teacher.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
