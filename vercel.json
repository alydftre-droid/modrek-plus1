{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.modrekplus.com"
        }
      ],
      "destination": "https://modrekplus.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "modrek-plus.vercel.app"
        }
      ],
      "destination": "https://modrekplus.com/$1",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/teacher-terms",
      "destination": "/teacher/terms",
      "permanent": true
    },
    {
      "source": "/account/delete",
      "destination": "/delete-account",
      "permanent": true
    },
    {
      "source": "/education/azhari",
      "destination": "/education/secondary-azhari",
      "permanent": true
    },
    {
      "source": "/education/general",
      "destination": "/education/secondary-general",
      "permanent": true
    },
    {
      "source": "/complete-profile",
      "destination": "/select-education-type",
      "permanent": true
    },
    {
      "source": "/subject-ai-chat",
      "destination": "/ai",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/teacher/register",
      "destination": "/teacher-register/index.html"
    },
    {
      "source": "/:route(auth|forgot-password|reset-password|delete-account|pending-approval|select-education-type|dashboard|subjects|teacher-selection|profile|ai-chat|ai|student-exam|about-platform|support|wallet|student-subject|student-profile|student-progress|notifications|my-courses|my-library|category-subjects|student-security|teacher|admin)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/app-shell.html"
    },
    {
      "source": "/oauth/native-callback",
      "destination": "/app-shell.html"
    },
    {
      "source": "/.lovable/oauth/consent",
      "destination": "/app-shell.html"
    },
    {
      "source": "/subject/:subjectId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/ai/:section(study|exams|conversations)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/student/exams/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/student/bundles/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/my-library/book/:bookId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/wallet/deposit",
      "destination": "/app-shell.html"
    },
    {
      "source": "/support/assistant",
      "destination": "/app-shell.html"
    },
    {
      "source": "/ads/:id",
      "destination": "/app-shell.html"
    },
    {
      "source": "/teacher/:section(grade|assignments-diagnostics|subjects|students|messages|wallet|profile|settings|notifications|subject|student-management|assistant|edit-profile)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/teacher/settings/:section(account|security|support)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/teacher/upload/:subjectId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/teacher/upload/subject/:subjectId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/teacher/sub-subjects/:subjectId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/teacher/exams/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/:section(subscriptions|upload|subjects|content|notifications|settings|students|subjects-page|teachers|support|smart-reports|library|bundled-packages|ads|modrek-library|test-students|modrek-analytics|student-wallets)",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/upload/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/subjects/content",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/notifications/:id",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/teacher/:teacherId",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/developer/teacher/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/bundled-packages/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/modrek-library/:id",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin/student-wallets/:id",
      "destination": "/app-shell.html"
    }
  ]
}
