Enterimport { serve } from "https://deno.land/std@0.168.0/http/server.ts"

const OPENAI_API_KEY = Deno.env.get("OPENAI_API_KEY")

serve(async (req) => {
  try {
    if (!OPENAI_API_KEY) {
      return new Response(
        JSON.stringify({ error: "Missing OpenAI API Key" }),
        { status: 500 }
      )
    }

    const { subjectName, lessonTitle, questionCount = 5, difficulty = "متوسط" } =
      await req.json()

    const prompt = `
أنت مساعد متخصص في إنشاء امتحانات تعليمية.

أنشئ امتحان في مادة: ${subjectName}
الدرس: ${lessonTitle}
عدد الأسئلة: ${questionCount}
مستوى الصعوبة: ${difficulty}

الشروط:
- أسئلة اختيار من متعدد فقط
- 4 اختيارات لكل سؤال
- إجابة صحيحة واحدة فقط
- لا تضف أي شرح
- أرجع النتيجة بصيغة JSON فقط بهذا الشكل:

{
  "questions": [
    {
      "question": "نص السؤال",
      "options": ["A", "B", "C", "D"],
      "correct_answer": "A"
    }
  ]
}
`

    const openaiRes = await fetch("https://api.openai.com/v1/chat/completions", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${OPENAI_API_KEY}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        model: "gpt-4o-mini",
        messages: [
          { role: "system", content: "أنت مولد امتحانات احترافي." },
          { role: "user", content: prompt }
        ],
        temperature: 0.7
      })
    })

    const data = await openaiRes.json()

    const content = data.choices?.[0]?.message?.content

    if (!content) {
      return new Response(
        JSON.stringify({ error: "Invalid AI response" }),
        { status: 500 }
      )
    }

    return new Response(content, {
      headers: { "Content-Type": "application/json" }
    })

  } catch (error) {
    return new Response(
      JSON.stringify({ error: error.message }),
      { status: 500 }
    )
  }
})
